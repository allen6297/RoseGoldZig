<templateSet group="RoseGold">
  <template name="func" value="func $NAME$($PARAMS$):&#10;    $END$"
            description="function definition" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;name&quot;" alwaysStopAt="true"/>
    <variable name="PARAMS" expression="" defaultValue="" alwaysStopAt="true"/>
    <context><option name="ROSEGOLD" value="true"/></context>
  </template>

  <template name="main" value="func main():&#10;    $END$"
            description="main function" toReformat="false" toShortenFQNames="false">
    <context><option name="ROSEGOLD" value="true"/></context>
  </template>

  <template name="for" value="for $VAR$ in $ITER$:&#10;    $END$"
            description="for loop" toReformat="false" toShortenFQNames="false">
    <variable name="VAR" expression="" defaultValue="&quot;x&quot;" alwaysStopAt="true"/>
    <variable name="ITER" expression="" defaultValue="&quot;xs&quot;" alwaysStopAt="true"/>
    <context><option name="ROSEGOLD" value="true"/></context>
  </template>

  <template name="while" value="while $COND$:&#10;    $END$"
            description="while loop" toReformat="false" toShortenFQNames="false">
    <variable name="COND" expression="" defaultValue="&quot;true&quot;" alwaysStopAt="true"/>
    <context><option name="ROSEGOLD" value="true"/></context>
  </template>

  <template name="if" value="if $COND$:&#10;    $END$"
            description="if statement" toReformat="false" toShortenFQNames="false">
    <variable name="COND" expression="" defaultValue="" alwaysStopAt="true"/>
    <context><option name="ROSEGOLD" value="true"/></context>
  </template>

  <template name="class" value="class $NAME$:&#10;    $END$"
            description="class definition" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;Name&quot;" alwaysStopAt="true"/>
    <context><option name="ROSEGOLD" value="true"/></context>
  </template>

  <template name="struct" value="struct $NAME$:&#10;    $END$"
            description="struct definition" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;Name&quot;" alwaysStopAt="true"/>
    <context><option name="ROSEGOLD" value="true"/></context>
  </template>

  <template name="match" value="match $SUBJ$ {&#10;    $PATTERN$: $END$&#10;}"
            description="match expression" toReformat="false" toShortenFQNames="false">
    <variable name="SUBJ" expression="" defaultValue="" alwaysStopAt="true"/>
    <variable name="PATTERN" expression="" defaultValue="&quot;_&quot;" alwaysStopAt="true"/>
    <context><option name="ROSEGOLD" value="true"/></context>
  </template>

  <template name="try" value="try:&#10;    $BODY$&#10;catch $E$:&#10;    $END$"
            description="try/catch" toReformat="false" toShortenFQNames="false">
    <variable name="BODY" expression="" defaultValue="&quot;pass&quot;" alwaysStopAt="true"/>
    <variable name="E" expression="" defaultValue="&quot;e&quot;" alwaysStopAt="true"/>
    <context><option name="ROSEGOLD" value="true"/></context>
  </template>

  <template name="enum" value="enum $NAME$ { $CASES$ }$END$"
            description="enum definition" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;Name&quot;" alwaysStopAt="true"/>
    <variable name="CASES" expression="" defaultValue="&quot;A, B&quot;" alwaysStopAt="true"/>
    <context><option name="ROSEGOLD" value="true"/></context>
  </template>

  <template name="elif" value="elif $COND$:&#10;    $END$"
            description="elif branch" toReformat="false" toShortenFQNames="false">
    <variable name="COND" expression="" defaultValue="" alwaysStopAt="true"/>
    <context><option name="ROSEGOLD" value="true"/></context>
  </template>
</templateSet>
