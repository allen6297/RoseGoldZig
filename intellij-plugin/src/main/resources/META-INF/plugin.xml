<idea-plugin>
    <id>org.rosegold.ide</id>
    <name>RoseGold</name>
    <vendor>RoseGold</vendor>

    <description><![CDATA[
        Language support for <b>RoseGold</b> (<code>.rg</code>) files:
        <ul>
            <li>Syntax highlighting (keywords, types, strings, numbers, comments; function defs vs. calls)</li>
            <li><code>##</code> line-comment toggling and brace matching</li>
            <li>Keyword, builtin &amp; member completion (a typed local's <code>x.method()</code>)</li>
            <li>Quick-doc / hover (Ctrl-Q) for builtins, your declarations (signature + <code>##</code> docs), imported <code>mod.member</code>s, parameters, enum cases, and static members (<code>Type.member</code>)</li>
            <li>Rename refactoring (Shift+F6) across the file</li>
            <li>Live error highlighting via the RoseGold compiler's <code>check</code> command</li>
            <li>Structure view, code folding, and reformatting via <code>fmt</code></li>
            <li>Live templates, auto-indent after <code>:</code>, go-to-declaration, and find-usages</li>
            <li>Run configurations that execute a file on the tree-walker or the bytecode VM</li>
        </ul>
        Set the path to the <code>RoseGold_Zig</code> executable in
        <i>Settings | Languages &amp; Frameworks | RoseGold</i>.
    ]]></description>

    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="RoseGold" implementationClass="org.rosegold.ide.RoseGoldFileType"
                  fieldName="INSTANCE" language="RoseGold" extensions="rg"/>
        <lang.parserDefinition language="RoseGold"
                               implementationClass="org.rosegold.ide.RoseGoldParserDefinition"/>
        <lang.syntaxHighlighterFactory language="RoseGold"
                                       implementationClass="org.rosegold.ide.RoseGoldSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="org.rosegold.ide.RoseGoldColorSettingsPage"/>
        <!-- Default attributes for the RoseGold keys, so the Color Scheme page shows
             each category as directly editable (not merely inherited from a fallback). -->
        <additionalTextAttributes scheme="Default" file="colorSchemes/RoseGoldDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/RoseGoldDarcula.xml"/>
        <lang.commenter language="RoseGold" implementationClass="org.rosegold.ide.RoseGoldCommenter"/>
        <lang.braceMatcher language="RoseGold" implementationClass="org.rosegold.ide.RoseGoldBraceMatcher"/>
        <lang.quoteHandler language="RoseGold" implementationClass="org.rosegold.ide.RoseGoldQuoteHandler"/>
        <typedHandler implementation="org.rosegold.ide.RoseGoldTypedHandler"/>
        <completion.contributor language="RoseGold"
                                implementationClass="org.rosegold.ide.RoseGoldCompletionContributor"/>
        <codeInsight.parameterInfo language="RoseGold"
                                   implementationClass="org.rosegold.ide.RoseGoldParameterInfoHandler"/>
        <codeInsight.inlayProvider language="RoseGold"
                                   implementationClass="org.rosegold.ide.RoseGoldInlayHintsProvider"/>
        <externalAnnotator language="RoseGold"
                           implementationClass="org.rosegold.ide.RoseGoldExternalAnnotator"/>
        <externalFormatProcessor implementation="org.rosegold.ide.RoseGoldFormattingProcessor"/>
        <lang.psiStructureViewFactory language="RoseGold"
                                      implementationClass="org.rosegold.ide.structure.RoseGoldStructureViewFactory"/>
        <lang.foldingBuilder language="RoseGold" implementationClass="org.rosegold.ide.RoseGoldFoldingBuilder"/>
        <lang.documentationProvider language="RoseGold"
                                    implementationClass="org.rosegold.ide.RoseGoldDocumentationProvider"/>
        <enterHandlerDelegate implementation="org.rosegold.ide.RoseGoldEnterHandler"/>
        <defaultLiveTemplates file="/liveTemplates/RoseGold.xml"/>
        <liveTemplateContext contextId="ROSEGOLD"
                             implementation="org.rosegold.ide.RoseGoldTemplateContextType"/>
        <psi.referenceContributor language="RoseGold"
                                  implementation="org.rosegold.ide.RoseGoldReferenceContributor"/>
        <lang.findUsagesProvider language="RoseGold"
                                 implementationClass="org.rosegold.ide.RoseGoldFindUsagesProvider"/>
        <renameHandler implementation="org.rosegold.ide.RoseGoldRenameHandler"/>

        <applicationService serviceImplementation="org.rosegold.ide.RoseGoldSettings"/>
        <applicationConfigurable parentId="language"
                                 id="org.rosegold.ide.RoseGoldConfigurable"
                                 displayName="RoseGold"
                                 instance="org.rosegold.ide.RoseGoldConfigurable"/>

        <configurationType implementation="org.rosegold.ide.run.RoseGoldRunConfigurationType"/>
        <runConfigurationProducer implementation="org.rosegold.ide.run.RoseGoldRunConfigurationProducer"/>
    </extensions>
</idea-plugin>
