{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RoseGold",
  "scopeName": "source.rosegold",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#declaration" },
    { "include": "#call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.rosegold",
          "match": "##.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.rosegold",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.rosegold",
          "match": "\\\\([\"\\\\$nrt]|u[0-9A-Fa-f]+)"
        },
        {
          "name": "meta.template.expression.rosegold",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.rosegold" } },
          "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.rosegold" } },
          "patterns": [
            { "include": "#numbers" },
            { "include": "#keywords" },
            { "include": "#constants" },
            { "include": "#call" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.rosegold",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rosegold",
          "match": "\\b(if|elif|else|while|for|in|break|continue|return|pass|match|raise|try|catch)\\b"
        },
        {
          "name": "keyword.operator.logical.rosegold",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.declaration.rosegold",
          "match": "\\b(func|class|struct|enum|signal|const|var|import)\\b"
        },
        {
          "name": "storage.modifier.rosegold",
          "match": "\\b(pub|private|static|extends|uses)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.rosegold",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.rosegold",
          "match": "\\b(int|float|str|bool|void|any|list|map)\\b"
        }
      ]
    },
    "declaration": {
      "patterns": [
        {
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.rosegold" },
            "2": { "name": "entity.name.function.rosegold" }
          }
        },
        {
          "match": "\\b(class|struct|enum|signal)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.rosegold" },
            "2": { "name": "entity.name.type.rosegold" }
          }
        }
      ]
    },
    "call": {
      "patterns": [
        {
          "name": "meta.function-call.rosegold",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.rosegold" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rosegold",
          "match": "->|\\.\\.|[-+*/%<>=!]=?|="
        }
      ]
    }
  }
}
