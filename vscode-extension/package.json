{
  "name": "rosegold",
  "displayName": "RoseGold",
  "description": "Language support for RoseGold (.rg): syntax highlighting, a language-server client (diagnostics, hover, go-to-definition, symbols), and a debugger (breakpoints, stepping, variables).",
  "version": "0.2.0",
  "publisher": "rosegold",
  "license": "MIT",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages", "Debuggers"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:rosegold", "onDebugResolve:rosegold"],
  "contributes": {
    "languages": [
      {
        "id": "rosegold",
        "aliases": ["RoseGold", "rosegold"],
        "extensions": [".rg"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rosegold",
        "scopeName": "source.rosegold",
        "path": "./syntaxes/rosegold.tmLanguage.json"
      }
    ],
    "breakpoints": [{ "language": "rosegold" }],
    "debuggers": [
      {
        "type": "rosegold",
        "label": "RoseGold",
        "languages": ["rosegold"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .rg file to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause at the first statement.",
                "default": true
              },
              "rosegoldPath": {
                "type": "string",
                "description": "Path to the RoseGold_Zig executable (defaults to rosegold.serverPath or PATH)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "rosegold",
            "request": "launch",
            "name": "Debug RoseGold file",
            "program": "${file}",
            "stopOnEntry": true
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "rosegold.run",
        "title": "RoseGold: Run Current File"
      },
      {
        "command": "rosegold.restartServer",
        "title": "RoseGold: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "RoseGold",
      "properties": {
        "rosegold.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the RoseGold_Zig executable. If empty, 'RoseGold_Zig' on your PATH is used."
        },
        "rosegold.useVm": {
          "type": "boolean",
          "default": false,
          "description": "Run files on the bytecode VM (run --vm) instead of the tree-walker."
        },
        "rosegold.enableLanguageServer": {
          "type": "boolean",
          "default": true,
          "description": "Start the RoseGold language server for live diagnostics, hover, and navigation."
        },
        "rosegold.importPaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra module search roots for imports not found relative to the importing file. Relative paths resolve against the first workspace folder. The workspace folders themselves are always searched."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0"
  }
}
