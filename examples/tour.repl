## A guided RoseGold REPL tour. Feed it to an interactive session:
##
##   zig build run -- repl < examples/tour.repl
##
## Each non-blank line is one entry; a blank line closes an indented block.
## Bare expressions print their value; definitions and statements do not.

(3 + 4) * 2

var name = "RoseGold"
"hello, " + name

var xs = [1, 2, 3]
push(xs, 4)
xs
len(xs)

func fib(n):
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

fib(10)

class Point:
    var x = 0
    var y = 0
    func dist2():
        return x * x + y * y

var p = Point()
p.x = 3
p.y = 4
p.dist2()

nope + 1
"still alive"
