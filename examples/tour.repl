## A guided RoseGold REPL tour. Feed it to an interactive session:
##
##   zig build run -- repl < examples/tour.repl
##
## Each non-blank line is one entry; a blank line closes an indented block.
## Bare expressions print their value; definitions and statements do not.
## Every entry is type-checked first, so the two deliberate mistakes near the
## end are reported and skipped while the session keeps going.

(3 + 4) * 2

var name = "RoseGold"
"hello, " + name

## Collections and their builtins.
var xs = [1, 2, 3]
push(xs, 4)
xs
len(xs)

## Compound assignment.
var n = 10
n += 5
n *= 2
n

## A recursive function.
func fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

fib(10)

## Static members shared on the type.
class Counter:
    static var count = 0
    static func inc():
        count += 1

Counter.inc()
Counter.inc()
Counter.count

## A class with a constructor and a method.
class Point:
    var x = 0
    var y = 0
    func init(px, py):
        x = px
        y = py
    func dist2() -> int:
        return x * x + y * y

var p = Point(3, 4)
p.dist2()

## Signals: connect a handler, then fire it.
signal pinged(msg)
func on_ping(msg):
    print("got:", msg)

connect(pinged, on_ping)
emit(pinged, "hello")

## Two deliberate mistakes, caught by the checker and not run:
var oops: str = n
Point(1)
